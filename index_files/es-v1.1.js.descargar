var i18nLocaleStrings = '{\"\":{\"plural_forms\":\"nplurals=2; plural=n != 1;\",\"language\":\"es\",\"localeSlug\":\"es\",\"momentjs_locale\":{\"months\":[\"enero\",\"febrero\",\"marzo\",\"abril\",\"mayo\",\"junio\",\"julio\",\"agosto\",\"septiembre\",\"octubre\",\"noviembre\",\"diciembre\"],\"monthsShort\":[\"Ene\",\"Feb\",\"Mar\",\"Abr\",\"May\",\"Jun\",\"Jul\",\"Ago\",\"Sep\",\"Oct\",\"Nov\",\"Dic\"],\"weekdays\":[\"domingo\",\"lunes\",\"martes\",\"mi\u00e9rcoles\",\"jueves\",\"viernes\",\"s\u00e1bado\"],\"weekdaysShort\":[\"Dom\",\"Lun\",\"Mar\",\"Mi\u00e9\",\"Jue\",\"Vie\",\"S\u00e1b\"],\"weekdaysMin\":[\"D\",\"L\",\"M\",\"X\",\"J\",\"V\",\"S\"],\"meridiem\":{\"am\":\"am\",\"pm\":\"pm\",\"AM\":\"AM\",\"PM\":\"PM\"},\"textDirection\":\"ltr\",\"numberFormat\":{\"thousands_sep\":\".\",\"decimal_point\":\",\"},\"longDateFormat\":{\"LT\":\"HH:mm\",\"L\":\"DD\\\/MM\\\/YYYY\",\"LL\":\"D MMMM YYYY\",\"LLL\":\"D MMMM YYYY LT\",\"LLLL\":\"dddd, D MMMM YYYY LT\"},\"calendar\":{\"sameDay\":\"[Today at] LT\",\"nextDay\":\"[Tomorrow at] LT\",\"nextWeek\":\"dddd [at] LT\",\"lastDay\":\"[Yesterday at] LT\",\"lastWeek\":\"[Last] dddd [at] LT\",\"sameElse\":\"L\"},\"relativeTime\":{\"future\":\"in %s\",\"past\":\"%s ago\",\"s\":\"a few seconds\",\"m\":\"a minute\",\"mm\":\"%d minutes\",\"h\":\"an hour\",\"hh\":\"%d hours\",\"d\":\"a day\",\"dd\":\"%d days\",\"M\":\"a month\",\"MM\":\"%d months\",\"y\":\"a year\",\"yy\":\"%d years\"},\"week\":{\"dow\":0,\"doy\":4}}},\"0\":[\"0\"],\"1\":[\"1\"],\"2\":[\"2\"],\"3\":[\"3\"],\"4\":[\"4\"],\"Set up %(productName)s and start advertising\":[\"Configura %(productName)s y empieza a anunciarte\"],\"To get started, go to the Jetpack settings page and follow the steps below.\":[\"Para empezar, ve a la p\u00e1gina de ajustes de Jetpack y sigue los siguientes pasos.\"],\"Navigate to your site\u0027s {{a}}Traffic settings{{\\\/a}}.\":[\"Ve a los {{a}}ajustes de tr\u00e1fico{{\\\/a}} de tu sitio.\"],\"Set %(productName)s as active.\":[\"Establece %(productName)s como activo.\"],\"Refresh this page.\":[\"Actualiza esta p\u00e1gina.\"],\"Create ads from your products in a snap with %(productName)s\":[\"Crea anuncios con tus productos en un instante con %(productName)s\"],\"Create ads from your content in a snap with %(productName)s\":[\"Crea anuncios con tu contenido en un instante con %(productName)s\"],\"The simplest way to promote your site to over 100 million users across WordPress and Tumblr.\":[\"La forma m\u00e1s sencilla de promocionar tu sitio entre m\u00e1s de 100 millones de usuarios en WordPress y Tumblr.\"],\"Turn your products into ads in just a few clicks.\":[\"Convierte tus productos en anuncios con solo un par de clics.\"],\"Turn your content into ads in just a few clicks.\":[\"Convierte tu contenido en anuncios con solo un par de clics.\"],\"Connect now\":[\"Conectar ahora\"],\"Drive traffic to your products\":[\"Atrae tr\u00e1fico a tus productos\"],\"Boost sales and revenue\":[\"Aumenta las ventas y los ingresos\"],\"Reach a wider audience\":[\"Llega a m\u00e1s gente\"],\"Grow your customer base\":[\"Ampl\u00eda tu base de clientes\"],\"Grow your audience and subscribers\":[\"Ampl\u00eda tu audiencia y tus suscriptores\"],\"Tap into a network of 100 million users\":[\"Forma parte de una red de 100 millones de usuarios\"],\"Turn content into compelling ads\":[\"Convierte contenido en atractivos anuncios\"],\"Start with just %(minDailyBudget)s per day\":[\"Empieza con solo %(minDailyBudget)s al d\u00eda\"],\"%(productName)s is built for merchants who have a business to run and no time for endless settings. You can start driving traffic in just a few minutes.\":[\"%(productName)s est\u00e1 dise\u00f1ado para comerciantes que tienen un negocio que gestionar y no tienen tiempo para ajustes interminables. Puedes empezar a generar tr\u00e1fico en solo unos minutos.\"],\"%(productName)s is built for creators who have stories to tell but no time for complex ad platforms. You can launch a campaign in just a few minutes.\":[\"%(productName)s est\u00e1 dise\u00f1ado para creadores que tienen historias que contar, pero no hay tiempo para plataformas publicitarias complejas. Puedes lanzar una campa\u00f1a en solo unos minutos.\"],\"Create ads directly from your product catalog or upload custom images to showcase your brand. The AI assistant helps draft compelling copy, while geographic and interest targeting connects you with the customers most likely to buy.\":[\"Crea anuncios directamente desde tu cat\u00e1logo de productos o sube im\u00e1genes personalizadas para dar a conocer tu marca. El asistente de IA te puede ayudar a redactar textos interesantes y atractivos, mientras que la segmentaci\u00f3n geogr\u00e1fica y por intereses te conecta con los clientes m\u00e1s propensos a comprar.\"],\"Instantly turn your existing posts into ads, or upload custom images. The AI assistant helps refine your message, while interest targeting ensures you connect with the people who matter most.\":[\"Convierte al instante tus entradas en anuncios o sube im\u00e1genes personalizadas. El asistente de IA te puede ayudar a perfeccionar el mensaje, mientras que la segmentaci\u00f3n por intereses te conecta con las personas que buscas.\"],\"Promote your products.\":[\"Promociona tus productos.\"],\"Choose your best content.\":[\"Elige tu mejor contenido.\"],\"Select items directly from your inventory and transform them into ads with a single click.\":[\"Selecciona art\u00edculos directamente de tu inventario y convi\u00e9rtelos en anuncios con un solo clic.\"],\"Transform your top-performing posts and pages into ads with a single click.\":[\"Transforma tus p\u00e1ginas y entradas con mejor rendimiento en anuncios con un solo clic.\"],\"Find the right customers.\":[\"Llega al cliente ideal.\"],\"Find your ideal crowd.\":[\"Llega a tu p\u00fablico ideal.\"],\"We present your products to interested shoppers right where they are browsing.\":[\"Presentamos tus productos a los compradores interesados est\u00e9n donde est\u00e9n.\"],\"We display your stories where interested users are already looking to discover new content.\":[\"Haremos que tus historias aparezcan donde los usuarios interesados puedan descubrirlas.\"],\"Drive results.\":[\"Impulsa los resultados.\"],\"Experience growth.\":[\"Sube a lo m\u00e1s alto.\"],\"See the impact on your store traffic for just %(minDailyBudget)s per day and gain the momentum you need.\":[\"Descubre el impacto en el tr\u00e1fico de tu tienda por solo %(minDailyBudget)s al d\u00eda y consigue el impulso que necesitas.\"],\"Start building momentum and traffic for just %(minDailyBudget)s per day.\":[\"Empieza a generar impulso y tr\u00e1fico por solo %(minDailyBudget)s al d\u00eda.\"],\"Frequently asked questions\":[\"Preguntas frecuentes\"],\"How does %(productName)s differ from organic traffic growth?\":[\"\u00bfEn qu\u00e9 se diferencia %(productName)s del crecimiento org\u00e1nico del tr\u00e1fico?\"],\"Organic growth is essential but often slow. %(productName)s amplifies your reach immediately. Instead of waiting for users to find you via search, it proactively places your content or products in the feeds of users who are already reading about related topics. It is designed to supplement your SEO efforts with immediate visibility.\":[\"El crecimiento org\u00e1nico es esencial, pero a menudo lento. %(productName)s amplifica tu alcance inmediatamente. En lugar de esperar a que los usuarios te encuentren a trav\u00e9s de la b\u00fasqueda, coloca de forma proactiva tu contenido o productos en los feeds de los usuarios que ya est\u00e1n leyendo sobre temas relacionados. Est\u00e1 dise\u00f1ado para complementar tus esfuerzos de SEO con visibilidad inmediata.\"],\"Do I need design skills to create ad creatives?\":[\"\u00bfNecesito saber algo de dise\u00f1o para crear un anuncio?\"],\"No. The tool automates the creative process by pulling the featured image and title from your existing post or product page. You have full control to edit the text or crop the image within the dashboard, but you do not need external design software to launch a professional-looking campaign.\":[\"\u00a1No! La herramienta automatiza el proceso creativo extrayendo la imagen destacada y el t\u00edtulo de la propia entrada o p\u00e1gina de producto. Tienes control total para editar el texto o recortar la imagen desde el escritorio, pero no necesitas ning\u00fan software de dise\u00f1o externo para lanzar una campa\u00f1a de aspecto profesional.\"],\"What can I expect from a minimum budget?\":[\"\u00bfQu\u00e9 puedo conseguir con un presupuesto m\u00ednimo?\"],\"Campaigns start at %(minDailyBudget)s per day. While higher budgets reach more people, the minimum spend is sufficient to generate thousands of impressions. This allows you to cost-effectively test different products or headlines to see what converts before committing to a larger budget.\":[\"Las campa\u00f1as comienzan con un presupuesto diario m\u00ednimo de %(minDailyBudget)s. Aunque los presupuestos m\u00e1s altos llegan a m\u00e1s personas, el gasto m\u00ednimo es suficiente para generar miles de impresiones. Esto te permite probar diferentes productos o titulares sin invertir demasiado para ver cu\u00e1les generan m\u00e1s conversiones antes de comprometerte con un presupuesto mayor.\"],\"How does this integrate with WooCommerce?\":[\"\u00bfC\u00f3mo se integra con WooCommerce?\"],\"%(productName)s is fully compatible with WooCommerce. You\u0027ll see all of your inventory, allowing you to select specific products to promote. You can target audiences based on interests (e.g., \\\"Fashion,\\\" \\\"Tech,\\\" \\\"DIY\\\"), sending high-intent traffic directly to your product.\":[\"%(productName)s es totalmente compatible con WooCommerce. Ver\u00e1s todo tu inventario, lo que te permitir\u00e1 seleccionar productos espec\u00edficos para promocionar. Puedes dirigirte al p\u00fablico en funci\u00f3n de tus intereses (p. ej., \\\"Fashion\\\", \\\"Tech\\\", \\\"DIY\\\") y enviar tr\u00e1fico de alto nivel directamente a tu producto.\"],\"Where exactly do the ads appear?\":[\"\u00bfD\u00f3nde aparecen los anuncios exactamente?\"],\"Your ads run as \\\"Sponsored Content\\\" across the WordPress.com and Tumblr networks, reaching a potential audience of over 100 million users. The ads appear natively within user feeds or website content that users are actively consuming.\":[\"Tus anuncios se publican como \u00abContenido patrocinado\u00bb en las redes de WordPress.com y Tumblr, llegando a una audiencia potencial de m\u00e1s de 100 millones de usuarios. Los anuncios aparecen de forma nativa en los feeds de los usuarios o en el contenido de las webs que estos consumen activamente.\"],\"Why is a WordPress.com connection required?\":[\"\u00bfPor qu\u00e9 es necesaria una conexi\u00f3n a WordPress.com?\"],\"The connection provides the necessary infrastructure for ad delivery and billing. It authenticates your site to broadcast content across the network and ensures secure payment processing. If you do not have an account, the setup process will guide you through creating one quickly.\":[\"La conexi\u00f3n proporciona la infraestructura necesaria para la entrega de los anuncios y para la facturaci\u00f3n. Sirve para autorizar a tu sitio a transmitir contenido a trav\u00e9s de la red y garantiza un procesamiento seguro de los pagos. Si no tienes una cuenta, el proceso de configuraci\u00f3n te ayudar\u00e1 a crear una r\u00e1pidamente.\"],\"Ready to get started?\":[\"\u00bfTodo listo para empezar?\"],\"Connect your site now to unlock the dashboard and start your first campaign.\":[\"Conecta tu sitio ahora para desbloquear el escritorio y empezar tu primera campa\u00f1a.\"],\"Your site is not eligible to Advertise with %(productName)s\":[\"Tu sitio no cumple los requisitos para anunciarse con %(productName)s\"],\"Unfortunately, your site doesn\u0027t qualify for advertising using %(productName)s. If you have any questions or need assistance, please contact our {{a}}support team{{\\\/a}}.\":[\"Lamentablemente, tu sitio no cumple los requisitos para anunciarse en %(productName)s. Si tienes alguna pregunta o necesitas ayuda, ponte en contacto con nuestro {{a}}equipo de soporte{{\\\/a}}.\"],\"Make sure your site is public\":[\"Aseg\u00farate de que tu sitio es p\u00fablico\"],\"Go to your WordPress.com dashboard and follow the steps below.\":[\"Ve a tu escritorio de WordPress.com y sigue los siguientes pasos.\"],\"Navigate to your site\u0027s {{a}}Privacy settings{{\\\/a}}.\":[\"Ve a los {{a}}ajustes de privacidad{{\\\/a}} de tu sitio.\"],\"Set your site as Public.\":[\"Establece tu sitio como p\u00fablico.\"],\"Read more on how to launch your site {{a}}here{{\\\/a}}. \":[\"Puedes encontrar m\u00e1s informaci\u00f3n sobre c\u00f3mo lanzar tu sitio {{a}}aqu\u00ed{{\\\/a}}.\"],\"Advertising\":[\"Publicidad\"],\"month\":[\"mes\"],\"month, billed annually\":[\"al mes, con facturaci\u00f3n anual\"],\"Monthly\":[\"Mensual\"],\"Annually\":[\"al a\u00f1o\"],\"Basic\":[\"B\u00e1sico\"],\"Domain\":[\"Dominio\"],\"Enter a valid domain name or leave empty to avoid showing any domain\":[\"Introduce un nombre de dominio v\u00e1lido o d\u00e9jalo en blanco para que no se muestre ning\u00fan dominio\"],\"Affiliate Link\":[\"Enlace de afiliado\"],\"Enter the affiliate link for the Upgrade CTA\":[\"Introduce el enlace de afiliado para el bot\u00f3n de mejorar plan\"],\"Price\":[\"Precio\"],\"Annual\":[\"Anual\"],\"for %s\":[\"para %s\"],\"<a>Learn more<\\\/a>\":[\"<a>M\u00e1s informaci\u00f3n<\\\/a>\"],\"The selected plan is not available at this moment\":[\"El plan seleccionado no est\u00e1 disponible en este momento \"],\"Save %s\":[\"Ahorra %s\"],\"Upgrade to %s\":[\"Mejorar a %s\"],\"Upgrade Pricing Plan\":[\"Mejorar plan de precios\"],\"Pricing Plan upgrade block\":[\"Bloque de mejora de plan de precios\"],\"pricing\":[\"precios\"],\"plans\":[\"planes\"],\"upgrade\":[\"mejorar\"],\"Upgrade %(planName)s\":[\"Mejorar %(planName)s\"],\"Upgrade to %(planName)s pricing plan\":[\"Mejorar al plan de pago %(planName)s\"],\"Help\":[\"Ayuda\"],\"Something went wrong\":[\"Se ha producido un error\"],\"Please close and reopen notifications.\":[\"Cierra y abre de nuevo las notificaciones.\"],\"Back\":[\"Volver\"],\"Previous notification\":[\"Notificaci\u00f3n anterior\"],\"Next notification\":[\"Siguiente notificaci\u00f3n\"],\"Today\":[\"Hoy\"],\"Yesterday\":[\"Ayer\"],\"Older than 2 days\":[\"Hace m\u00e1s de 2 d\u00edas\"],\"Older than a week\":[\"Hace m\u00e1s de 1 semana\"],\"Older than a month\":[\"Hace m\u00e1s de 1 mes\"],\"Pending\":[\"Pendiente\"],\"Icon\":[\"Icono\"],\"Title\":[\"T\u00edtulo\"],\"Description\":[\"Descripci\u00f3n\"],\"Date\":[\"Fecha\"],\"Detailed\":[\"Detallado\"],\"Simplified\":[\"Simplificado\"],\"Settings\":[\"Ajustes\"],\"Layout\":[\"Dise\u00f1o\"],\"New\":[\"Nuevo\"],\"Links\":[\"Enlaces\"],\"Notification settings (opens in a new tab)\":[\"Ajustes de las notificaciones (se abre en una nueva pesta\u00f1a)\"],\"Notification settings\":[\"Ajustes de avisos\"],\"Notifications\":[\"Avisos\"],\"Beta\":[\"Beta\"],\"Switch layouts (New)\":[\"Cambiar el dise\u00f1o (Novedad)\"],\"Choose how much detail each row shows.\":[\"Elige el nivel de detalle que aparece en cada fila.\"],\"Got it\":[\"Entendido\"],\"Toggle panel\":[\"Activar o desactivar el panel\"],\"Next\":[\"Siguiente\"],\"Previous\":[\"Anterior\"],\"Left\":[\"Izquierda\"],\"Right\":[\"Derecha\"],\"View all\":[\"Ver todo\"],\"View unread\":[\"Ver no le\u00eddos\"],\"View comments\":[\"Ver comentarios\"],\"View subscribers\":[\"Ver suscriptores\"],\"View likes\":[\"Ver \u00abMe Gusta\u00bb\"],\"Toggle shortcuts menu\":[\"Activar o desactivar el men\u00fa de atajos\"],\"Keyboard shortcuts\":[\"Atajos de teclado\"],\"just now\":[\"ahora mismo\"],\"Likes\":[\"Me gusta\"],\"Pending approval\":[\"Pendiente de aprobaci\u00f3n\"],\"Edit\":[\"Editar\"],\"Unapprove\":[\"Rechazar\"],\"Approve\":[\